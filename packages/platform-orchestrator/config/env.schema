# Platform Orchestrator Environment Schema
LLMOBS_DATA_DIR:
  type: string
  default: "./data"
  description: "Root persistent storage directory for stateful plane"
LLMOBS_PRIMARY_DATA_HOST:
  type: string
  default: "localhost"
  description: "Internal IP or host of primary stateful plane"
PORT_TRAEFIK_HTTP:
  type: integer
  default: 31410
PORT_TRAEFIK_DASHBOARD:
  type: integer
  default: 31411
PORT_TRAEFIK_HTTPS:
  type: integer
  default: 31419
PORT_GRAFANA:
  type: integer
  default: 31415
PORT_OTEL_HTTP:
  type: integer
  default: 31417
PORT_OTEL_GRPC:
  type: integer
  default: 31418
PORT_TEMPORAL_GRPC:
  type: integer
  default: 31424
PORT_SERVICE_REGISTRY:
  type: integer
  default: 31426
ORCHESTRATOR_HTTP_PORT:
  type: integer
  default: 31499
  description: "HTTP daemon port for REST API interface"
