# ─────────────────────────────────────────────────────────────
# Auth Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=auth-service
SERVICE_PORT=3003
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
ALLOYDB_HOST=localhost
PORT_ALLOYDB=31420
ALLOYDB_USER=admin
ALLOYDB_PASSWORD=llmobs_s3cret_2026
ALLOYDB_DB=llm_observability

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
REDIS_HOST=localhost
PORT_REDIS=31413
REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
KAFKA_BROKERS=localhost:31414
PORT_KAFKA=31414
KAFKA_CLIENT_ID=auth-service-client
KAFKA_GROUP_ID=auth-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
PORT_OTEL_HTTP=31417
PORT_OTEL_GRPC=31418

# ── Service Registry ─────────────────────────────────────────
SERVICE_REGISTRY_URL=http://localhost:31426
PORT_SERVICE_REGISTRY=31426

# ── Infrastructure Profiles ───────────────────────────────────
INFRA_PROFILES=db streaming tracing
