# ─────────────────────────────────────────────────────────────
# Audit Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=audit-service
SERVICE_PORT=3002
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=31420
AUDIT_DB_USER=admin
AUDIT_DB_PASSWORD=llmobs_s3cret_2026
AUDIT_DB_NAME=audit_log_db

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
AUDIT_REDIS_HOST=localhost
AUDIT_REDIS_PORT=31413
AUDIT_REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
KAFKA_BROKERS=localhost:31414
KAFKA_CLIENT_ID=audit-service-client
KAFKA_GROUP_ID=audit-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
OTEL_SERVICE_NAME=audit-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Service Registry ─────────────────────────────────────────
SERVICE_REGISTRY_URL=http://localhost:31426
