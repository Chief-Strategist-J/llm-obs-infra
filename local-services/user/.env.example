# ─────────────────────────────────────────────────────────────
# User Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=user-service
SERVICE_PORT=3001
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
# Default points to platform-orchestrator AlloyDB endpoint (PORT_ALLOYDB: 31420)
USER_DB_HOST=localhost
USER_DB_PORT=31420
USER_DB_USER=admin
USER_DB_PASSWORD=llmobs_s3cret_2026
USER_DB_NAME=user_profile_db

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
# Default points to platform-orchestrator Redis endpoint (PORT_REDIS: 31413)
USER_REDIS_HOST=localhost
USER_REDIS_PORT=31413
USER_REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
# Default points to platform-orchestrator Kafka endpoint (PORT_KAFKA: 31414)
KAFKA_BROKERS=localhost:31414
KAFKA_CLIENT_ID=user-service-client
KAFKA_GROUP_ID=user-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
# Default points to platform-orchestrator OTel Collector (HTTP: 31417, gRPC: 31418)
OTEL_SERVICE_NAME=user-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Service Registry ─────────────────────────────────────────
# Default points to platform-orchestrator Service Registry (PORT: 31426)
SERVICE_REGISTRY_URL=http://localhost:31426

# ── Infrastructure Profiles ───────────────────────────────────
# Profiles passed to 'llmobs up' when running './run.sh user up' with no args.
# Override per-run: ./run.sh user up db streaming
# Available: db | streaming | analytics | tracing | network | stateful | stateless | full
INFRA_PROFILES=db streaming tracing
