# ─────────────────────────────────────────────────────────────
# Payment Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=payment-service
SERVICE_PORT=3005
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=31420
PAYMENT_DB_USER=admin
PAYMENT_DB_PASSWORD=llmobs_s3cret_2026
PAYMENT_DB_NAME=payment_ledger_db

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
PAYMENT_REDIS_HOST=localhost
PAYMENT_REDIS_PORT=31413
PAYMENT_REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
KAFKA_BROKERS=localhost:31414
KAFKA_CLIENT_ID=payment-service-client
KAFKA_GROUP_ID=payment-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
OTEL_SERVICE_NAME=payment-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Service Registry ─────────────────────────────────────────
SERVICE_REGISTRY_URL=http://localhost:31426

# ── Infrastructure Profiles ───────────────────────────────────
INFRA_PROFILES=db streaming
