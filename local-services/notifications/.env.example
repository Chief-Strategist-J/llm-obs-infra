# ─────────────────────────────────────────────────────────────
# Notifications Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=notification-service
SERVICE_PORT=3004
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=31420
NOTIFICATION_DB_USER=admin
NOTIFICATION_DB_PASSWORD=llmobs_s3cret_2026
NOTIFICATION_DB_NAME=notification_db

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
NOTIFICATION_REDIS_HOST=localhost
NOTIFICATION_REDIS_PORT=31413
NOTIFICATION_REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
KAFKA_BROKERS=localhost:31414
KAFKA_CLIENT_ID=notification-service-client
KAFKA_GROUP_ID=notification-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Service Registry ─────────────────────────────────────────
SERVICE_REGISTRY_URL=http://localhost:31426
