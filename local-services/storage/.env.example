# ─────────────────────────────────────────────────────────────
# Storage Service — Configuration Environment Variables
# Connects directly to the central LLMObs Infrastructure Platform.
# ─────────────────────────────────────────────────────────────

# ── Service Identity ─────────────────────────────────────────
SERVICE_NAME=storage-service
SERVICE_PORT=3006
NODE_ENV=development

# ── Relational Database (AlloyDB / PostgreSQL) ───────────────
STORAGE_DB_HOST=localhost
STORAGE_DB_PORT=31420
STORAGE_DB_USER=admin
STORAGE_DB_PASSWORD=llmobs_s3cret_2026
STORAGE_DB_NAME=storage_metadata_db

# ── In-Memory Cache & Ledger (Redis) ─────────────────────────
STORAGE_REDIS_HOST=localhost
STORAGE_REDIS_PORT=31413
STORAGE_REDIS_PASSWORD=llmobs_redis_s3cret_2024

# ── Event Streaming (Kafka Broker) ───────────────────────────
KAFKA_BROKERS=localhost:31414
KAFKA_CLIENT_ID=storage-service-client
KAFKA_GROUP_ID=storage-service-group

# ── OpenTelemetry Telemetry Export ───────────────────────────
OTEL_SERVICE_NAME=storage-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:31417
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Service Registry ─────────────────────────────────────────
SERVICE_REGISTRY_URL=http://localhost:31426
