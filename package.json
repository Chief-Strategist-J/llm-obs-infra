{
  "name": "@observability/frontend-deployment",
  "version": "1.0.0",
  "private": true,
  "description": "Unified infrastructure, telemetry & security deployment package",
  "scripts": {
    "build": "make build",
    "up": "./bin/llmobs up",
    "restart": "./bin/llmobs restart",
    "down": "./bin/llmobs down",
    "status": "./bin/llmobs status",
    "logs": "./bin/llmobs logs",
    "health": "./bin/llmobs health",
    "scale": "./bin/llmobs scale",
    "certs": "./bin/llmobs certs",
    "setup": "./bin/llmobs setup",
    "backup": "./bin/llmobs backup-purge --backup-only",
    "backup-purge": "./bin/llmobs backup-purge",
    "cloudflare": "./bin/llmobs cloudflare",
    "free-ports": "./bin/llmobs free-ports",
    "server": "./bin/llmobs server",
    "frontend": "npm --prefix ../../node/web-app run web-app",
    "frontend:dev": "npm --prefix ../../node/web-app run dev",
    "test": "make test",
    "test:registry": "cd packages/service-discovery && go test -v ./tests/..."
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
